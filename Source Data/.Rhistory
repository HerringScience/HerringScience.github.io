two21 <- filter(relINFO, Year == "2021")
two22 <- filter(relINFO, Year == "2022")
two23 <- filter(relINFO, Year == "2023")
two24 <- filter(relINFO, Year == "2024")
year_summary <- relINFO %>%
group_by(Year) %>%
summarise(
TotalTags = sum(no_tags, na.rm = TRUE),
Events = n(),
.groups = "drop"
)
print(year_summary)
datatable(year_summary)
